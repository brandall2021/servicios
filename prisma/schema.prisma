generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum TipoFoto {
  SERVICIO
  PERFIL
  OPINION
  TRABAJO
}

enum ReportMotivo {
  SPAM
  FALSO
  INADECUADO
  OTRO
}

enum ReportEstado {
  PENDIENTE
  REVISADO
  RESUELTO
}

enum BudgetStatus {
  PENDIENTE
  COTIZADO
  ACEPTADO
  RECHAZADO
  REVISION
}

enum ListingType {
  SERVICE
  PRODUCT
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  REJECTED
  ARCHIVED
}

enum PriceType {
  FIXED
  FROM
  PER_UNIT
  QUOTE
}

enum FavoriteType {
  LISTING
  PROVIDER
}

enum ProviderApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum QuoteRequestStatus {
  PENDING
  QUOTED
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum InquiryStatus {
  DRAFT
  SENT
  RESPONDED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_PROVIDER
  COMPLETED
  NO_SHOW
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  PROMOTIONAL_PRICE
  BENEFIT
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  BOTH
}

enum ProviderKind {
  PERSONA
  EMPRESA
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  SUSPENDED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  phone         String?
  image         String?
  role          Role      @default(CLIENT)
  verified      Boolean   @default(false)
  baneado       Boolean   @default(false)
  motivoBaneo   String?
  description   String?
  experience    String?
  certifications String?
  zone          String?
  availability  String?
  whatsapp      String?
  website       String?
  facebook      String?
  instagram     String?
  rubro         String?
  documentacion String?
  solicitudProveedor Boolean @default(false)
  trabajosRealizados Int @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  providerProfile ProviderProfile?
  providerApplications ProviderApplication[]
  providerApplicationsReviewed ProviderApplication[] @relation("ProviderApplicationReviewer")
  providerApplicationEvents ProviderApplicationEvent[] @relation("ProviderApplicationActor")
  listings Listing[]
  favorites Favorite[] @relation("FavoriteUser")
  favoriteProviders Favorite[] @relation("FavoriteProvider")
  quoteRequestsAsClient QuoteRequest[] @relation("QuoteRequestClient")
  quotesAsProvider Quote[] @relation("QuoteProvider")
  quoteRequestHistory QuoteRequestHistory[] @relation("QuoteRequestActor")
  productInquiriesAsClient ProductInquiry[] @relation("ProductInquiryClient")
  productInquiriesAsProvider ProductInquiry[] @relation("ProductInquiryProvider")
  productInquiryQuotes ProductInquiryQuote[] @relation("ProductInquiryQuoteProvider")
  bookingsAsClient Booking[] @relation("BookingClient")
  bookingsAsProvider Booking[] @relation("BookingProvider")
  promotions Promotion[] @relation("PromotionProvider")

  servicios    Servicio[]
  opiniones    Opinion[]
  mensajesEnviados   Mensaje[]  @relation("MensajeEmisor")
  mensajesRecibidos  Mensaje[]  @relation("MensajeReceptor")
  fotos            Foto[]     @relation("UserFotos")
  chatsCreados      Chat[]      @relation("ChatCreador")
  chatsParticipante Chat[]      @relation("ChatParticipante")
  reportesHechos    Report[]   @relation("ReportesHechos")
  reportesRecibidos Report[]   @relation("ReportesRecibidos")
  presupuestoSolicitados BudgetRequest[] @relation("BudgetCliente")
  cotizacionesCreadas    BudgetQuote[]   @relation("BudgetProveedor")
  notificaciones         Notification[]
  auditoria              AuditLog[]

  resetToken            String?  @unique
  resetTokenExpiry      DateTime?
}

model Category {
  id        String      @id @default(cuid())
  type      ListingType
  name      String
  slug      String
  icon      String?
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  parentId  String?
  parent    Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]  @relation("CategoryTree")
  listings  Listing[]

  @@unique([type, slug])
  @@index([type, active, sortOrder])
}

model ProviderProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  kind               ProviderKind
  tradeName          String
  description        String?
  taxId              String?
  phone              String?
  whatsapp           String?
  website            String?
  facebook           String?
  instagram          String?
  coverageText       String?
  province           String?
  city               String?
  coverageRadiusKm   Int?
  offersServices     Boolean            @default(true)
  offersProducts     Boolean            @default(false)
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  verifiedAt         DateTime?
  responseTimeMinutes Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings           Listing[]
}

model ProviderApplication {
  id               String                   @id @default(cuid())
  userId           String                   @unique
  status           ProviderApplicationStatus @default(PENDING)
  submittedAt      DateTime                 @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  rejectionReason  String?
  suspensionReason String?
  documents        Json?

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?                    @relation("ProviderApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events           ProviderApplicationEvent[]

  @@index([status, submittedAt])
}

model ProviderApplicationEvent {
  id             String   @id @default(cuid())
  applicationId  String
  actorId        String?
  action         String
  note           String?
  payload        Json?
  createdAt      DateTime @default(now())

  application    ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor          User?              @relation("ProviderApplicationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

model Listing {
  id            String        @id @default(cuid())
  type          ListingType
  status        ListingStatus  @default(DRAFT)
  title         String
  slug          String         @unique
  description   String
  categoryId    String
  providerId    String
  providerProfileId String?
  featured      Boolean        @default(false)
  priceType     PriceType
  price         Decimal?       @db.Decimal(12, 2)
  currency      String         @default("ARS")
  priceUnit     String?
  locationText  String?
  latitude      Decimal?       @db.Decimal(9, 6)
  longitude     Decimal?       @db.Decimal(9, 6)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  provider      User           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile? @relation(fields: [providerProfileId], references: [id], onDelete: SetNull)
  service       ServiceDetails?
  product       ProductDetails?
  media         ListingMedia[]
  quoteRequests QuoteRequest[]
  productInquiryItems ProductInquiryItem[] @relation("ProductInquiryItemListing")
  bookings      Booking[]
  promotions    Promotion[]

  @@index([type, status, categoryId])
  @@index([providerId, status])
  @@index([providerProfileId, status])
  @@index([status, publishedAt])
  @@index([price])
}

model Favorite {
  id         String       @id @default(cuid())
  userId     String
  type       FavoriteType
  listingId  String?
  providerId String?
  createdAt  DateTime     @default(now())

  user       User         @relation("FavoriteUser", fields: [userId], references: [id], onDelete: Cascade)
  provider   User?        @relation("FavoriteProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@unique([userId, providerId])
  @@index([userId, type, createdAt])
}

model CommercialEvent {
  id          String   @id @default(cuid())
  type        String
  userId      String
  sessionId   String
  providerId  String?
  listingId   String?
  requestId   String?
  metadata    Json?
  occurredAt  DateTime @default(now())

  @@index([type, occurredAt])
  @@index([userId, occurredAt])
  @@index([providerId, occurredAt])
  @@index([listingId, occurredAt])
}

model ServiceDetails {
  listingId        String  @id
  modality         String?
  coverageRadiusKm Int?
  durationText     String?
  availabilityText String?
  includesText     String?
  excludesText     String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ProductDetails {
  listingId      String          @id
  sku            String?
  brand          String?
  unit           String
  stockQuantity  Decimal?        @db.Decimal(12, 3)
  trackStock     Boolean         @default(false)
  minimumOrder   Decimal?        @db.Decimal(12, 3)
  fulfillment    FulfillmentType @default(PICKUP)
  deliveryText   String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([sku])
  @@index([brand])
}

model ListingMedia {
  id         String   @id @default(cuid())
  listingId  String
  archivo    String
  mimeType   String?
  size       Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model QuoteRequest {
  id             String             @id @default(cuid())
  listingId      String
  clientId       String
  status         QuoteRequestStatus  @default(PENDING)
  description    String?
  quantity       Decimal?           @db.Decimal(12, 3)
  unit           String?
  fulfillment    FulfillmentType?
  desiredDate    DateTime?
  locationText   String?
  attachments    Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  listing        Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  client         User               @relation("QuoteRequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  quotes         Quote[]
  history        QuoteRequestHistory[]

  @@index([listingId, status])
  @@index([clientId, status])
}

model Quote {
  id            String   @id @default(cuid())
  requestId     String
  providerId    String
  version       Int
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("ARS")
  breakdown     String?
  conditions    String?
  validUntil    DateTime?
  estimatedReadyAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request       QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider      User         @relation("QuoteProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([requestId, version])
  @@index([providerId, createdAt])
}

model QuoteRequestHistory {
  id           String            @id @default(cuid())
  requestId    String
  fromStatus   QuoteRequestStatus?
  toStatus     QuoteRequestStatus
  action       String
  note         String?
  payload      Json?
  actorId      String
  createdAt    DateTime          @default(now())

  request      QuoteRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor        User              @relation("QuoteRequestActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
}

model ProductInquiry {
  id              String         @id @default(cuid())
  clientId        String
  providerId      String
  status          InquiryStatus   @default(DRAFT)
  deliveryMethod  FulfillmentType?
  deliveryAddress String?
  notes           String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client          User           @relation("ProductInquiryClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider        User           @relation("ProductInquiryProvider", fields: [providerId], references: [id], onDelete: Cascade)
  items           ProductInquiryItem[]
  quotes          ProductInquiryQuote[]

  @@index([clientId, status, updatedAt])
  @@index([providerId, status, updatedAt])
}

model ProductInquiryItem {
  id            String   @id @default(cuid())
  inquiryId     String
  listingId     String
  quantity      Decimal  @db.Decimal(12, 3)
  requestedUnit String?
  priceSnapshot Decimal? @db.Decimal(12, 2)
  titleSnapshot String
  notes         String?

  inquiry       ProductInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  listing       Listing        @relation("ProductInquiryItemListing", fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, listingId])
}

model ProductInquiryQuote {
  id               String   @id @default(cuid())
  inquiryId        String
  providerId       String
  version          Int
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("ARS")
  breakdown        String?
  conditions       String?
  validUntil       DateTime?
  estimatedReadyAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inquiry          ProductInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  provider         User           @relation("ProductInquiryQuoteProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, version])
  @@index([providerId, createdAt])
}

model Booking {
  id                String        @id @default(cuid())
  listingId         String
  clientId          String
  providerId        String
  status            BookingStatus @default(PENDING)
  startsAt          DateTime
  endsAt            DateTime
  timezone          String
  notes             String?
  cancellationReason String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  listing           Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  client            User          @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider          User          @relation("BookingProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startsAt, endsAt])
  @@index([clientId, startsAt])
}

model Promotion {
  id           String         @id @default(cuid())
  providerId   String
  listingId    String?
  type         PromotionType
  name         String
  code         String?
  value        Decimal?       @db.Decimal(12, 2)
  startsAt     DateTime
  endsAt       DateTime
  usageLimit   Int?
  perUserLimit Int?
  active       Boolean        @default(true)
  terms        String?
  createdAt    DateTime       @default(now())

  provider     User           @relation("PromotionProvider", fields: [providerId], references: [id], onDelete: Cascade)
  listing      Listing?       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([providerId, code])
  @@index([listingId, active, startsAt, endsAt])
}

model Servicio {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String
  categoria   String
  precio      Float?
  precioTexto String?
  ubicacion   String?
  lat         Float?
  lng         Float?
  disponibilidad String?
  website       String?
  facebook      String?
  instagram     String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  fotos       Foto[]
  opiniones   Opinion[]
  reportes    Report[]
  presupuestos BudgetRequest[]
}

model Foto {
  id         String   @id @default(cuid())
  archivo    String
  tipo       TipoFoto @default(SERVICIO)
  size       Int?
  mimeType   String?
  createdAt  DateTime @default(now())

  servicioId String?
  servicio   Servicio? @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  opinionId  String?
  opinion    Opinion?  @relation(fields: [opinionId], references: [id], onDelete: Cascade)
  usuarioId  String?
  usuario    User?     @relation("UserFotos", fields: [usuarioId], references: [id], onDelete: SetNull)
}

model Opinion {
  id         String   @id @default(cuid())
  puntuacion Int
  comentario String?
  createdAt  DateTime @default(now())

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  clienteId  String
  cliente    User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  fotos      Foto[]
  reportes   Report[]
}

model Report {
  id          String       @id @default(cuid())
  motivo      ReportMotivo
  descripcion String?
  estado      ReportEstado @default(PENDIENTE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  denuncianteId String
  denunciante   User   @relation("ReportesHechos", fields: [denuncianteId], references: [id], onDelete: Cascade)

  servicioId  String?
  servicio    Servicio? @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  opinionId   String?
  opinion     Opinion?  @relation(fields: [opinionId], references: [id], onDelete: SetNull)
  usuarioId   String?
  usuario     User?     @relation("ReportesRecibidos", fields: [usuarioId], references: [id], onDelete: SetNull)
}

model Chat {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creadorId     String
  creador       User     @relation("ChatCreador", fields: [creadorId], references: [id], onDelete: Cascade)
  participanteId String
  participante  User     @relation("ChatParticipante", fields: [participanteId], references: [id], onDelete: Cascade)

  mensajes      Mensaje[]
}

model Mensaje {
  id        String   @id @default(cuid())
  contenido String?
  imagen    String?
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())

  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  emisorId  String
  emisor    User     @relation("MensajeEmisor", fields: [emisorId], references: [id], onDelete: Cascade)
  receptorId String
  receptor  User     @relation("MensajeReceptor", fields: [receptorId], references: [id], onDelete: Cascade)
}

model BudgetRequest {
  id          String       @id @default(cuid())
  description String?
  materiales  String?
  archivos    String?
  status      BudgetStatus @default(PENDIENTE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  servicioId  String
  servicio    Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  clienteId   String
  cliente     User     @relation("BudgetCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  cotizaciones BudgetQuote[]
}

model BudgetQuote {
  id          String   @id @default(cuid())
  amount      Float
  breakdown   String?
  notes       String?
  validUntil  DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requestId    String
  request      BudgetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  proveedorId  String
  proveedor    User         @relation("BudgetProveedor", fields: [proveedorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactView {
  id         String   @id @default(cuid())
  tipo       String   // phone, whatsapp, website, facebook, instagram
  targetId   String   // user id or service id
  targetType String   // "proveedor" | "servicio"
  userId     String
  createdAt  DateTime @default(now())

  @@index([targetId, targetType])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  accion    String   // cambio_rol, banear, desbanear, eliminar, crear_usuario, editar_usuario, aprobar_proveedor, rechazar_proveedor
  detalle   String?  // descripción legible
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  targetId  String?  // id del usuario afectado
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}
